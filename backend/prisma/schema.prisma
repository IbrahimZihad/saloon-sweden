generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  STAFF
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  ONLINE
  PHONE
  ADMIN
}

enum NotificationType {
  BOOKING_CONFIRMATION
  APPOINTMENT_CONFIRMATION
  CANCELLATION
  RESCHEDULE
  REMINDER
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// ---------------------------------------------------------------------------
// Auth & people
// ---------------------------------------------------------------------------

model User {
  id                 String    @id @default(cuid())
  email              String    @unique @db.VarChar(190)
  passwordHash       String    @db.VarChar(255)
  name               String    @db.VarChar(120)
  role               Role      @default(STAFF)
  active             Boolean   @default(true)
  passwordResetToken String?   @unique @db.VarChar(190)
  passwordResetExpires DateTime? @db.DateTime(3)
  createdAt          DateTime  @default(now()) @db.DateTime(3)
  updatedAt          DateTime  @updatedAt @db.DateTime(3)

  staffMember Staff?
}

model Customer {
  id            String   @id @default(cuid())
  fullName      String   @db.VarChar(160)
  email         String   @unique @db.VarChar(190)
  phone         String   @db.VarChar(40)
  notes         String?  @db.Text
  marketingConsent Boolean @default(false)
  createdAt     DateTime @default(now()) @db.DateTime(3)
  updatedAt     DateTime @updatedAt @db.DateTime(3)

  appointments  Appointment[]

  @@index([phone])
  @@index([fullName])
}

model Staff {
  id          String   @id @default(cuid())
  userId      String?  @unique
  name        String   @db.VarChar(120)
  slug        String   @unique @db.VarChar(120)
  email       String   @unique @db.VarChar(190)
  phone       String?  @db.VarChar(40)
  jobTitle    String   @db.VarChar(120)
  bio         String?  @db.Text
  imageUrl    String?  @db.VarChar(500)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)

  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  services      StaffService[]
  workingHours  StaffWorkingHours[]
  breaks        StaffBreak[]
  timeOffs      StaffTimeOff[]
  appointments  Appointment[]

  @@index([active])
}

// ---------------------------------------------------------------------------
// Services
// ---------------------------------------------------------------------------

model ServiceCategory {
  id        String   @id @default(cuid())
  slug      String   @unique @db.VarChar(120)
  nameSv    String   @db.VarChar(120)
  nameEn    String   @db.VarChar(120)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  services Service[]
}

model Service {
  id          String   @id @default(cuid())
  categoryId  String
  slug        String   @unique @db.VarChar(160)
  nameSv      String   @db.VarChar(160)
  nameEn      String   @db.VarChar(160)
  descriptionSv String? @db.Text
  descriptionEn String? @db.Text
  // Monetary values stored as MySQL DECIMAL via Prisma.Decimal
  price       Decimal  @db.Decimal(10, 2)
  durationMinutes Int
  imageUrl    String?  @db.VarChar(500)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)

  category    ServiceCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  staff       StaffService[]
  appointmentServices AppointmentService[]

  @@index([categoryId, active])
}

model StaffService {
  staffId   String
  serviceId String
  createdAt DateTime @default(now()) @db.DateTime(3)

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([serviceId])
}

// ---------------------------------------------------------------------------
// Scheduling configuration
// ---------------------------------------------------------------------------

// One row per weekday. Minutes since local midnight; isClosed overrides times.
model BusinessHours {
  id           String  @id @default(cuid())
  dayOfWeek    Int     @unique // 0 = Monday ... 6 = Sunday
  openMinutes  Int     @default(540)
  closeMinutes Int     @default(1080)
  isClosed     Boolean @default(false)
  createdAt    DateTime @default(now()) @db.DateTime(3)
  updatedAt    DateTime @updatedAt @db.DateTime(3)
}

model StaffWorkingHours {
  id           String  @id @default(cuid())
  staffId      String
  dayOfWeek    Int // 0 = Monday ... 6 = Sunday
  startMinutes Int
  endMinutes   Int
  createdAt    DateTime @default(now()) @db.DateTime(3)
  updatedAt    DateTime @updatedAt @db.DateTime(3)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
}

// Recurring daily break, e.g. lunch 13:00-14:00 on working days.
model StaffBreak {
  id           String @id @default(cuid())
  staffId      String
  dayOfWeek    Int // 0 = Monday ... 6 = Sunday
  startMinutes Int
  endMinutes   Int
  label        String? @db.VarChar(120)
  createdAt    DateTime @default(now()) @db.DateTime(3)
  updatedAt    DateTime @updatedAt @db.DateTime(3)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, dayOfWeek])
}

// One-off holiday / time off. Instants stored in UTC.
model StaffTimeOff {
  id        String   @id @default(cuid())
  staffId   String
  startsAt  DateTime @db.DateTime(3)
  endsAt    DateTime @db.DateTime(3)
  reason    String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, startsAt, endsAt])
}

// ---------------------------------------------------------------------------
// Appointments
// ---------------------------------------------------------------------------

model Appointment {
  id              String            @id @default(cuid())
  bookingReference String           @unique @db.VarChar(20)
  customerId      String
  staffId         String
  // Actual instants, always UTC. Local time is derived via the business timezone.
  startsAt        DateTime          @db.DateTime(3)
  endsAt          DateTime          @db.DateTime(3)
  durationMinutes Int
  totalPrice      Decimal           @db.Decimal(10, 2)
  status          AppointmentStatus @default(CONFIRMED)
  source          AppointmentSource @default(ONLINE)
  customerNotes   String?           @db.Text
  internalNotes   String?           @db.Text
  cancelReason    String?           @db.VarChar(500)
  cancelledAt     DateTime?         @db.DateTime(3)
  createdAt       DateTime          @default(now()) @db.DateTime(3)
  updatedAt       DateTime          @updatedAt @db.DateTime(3)

  customer      Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  staff         Staff                @relation(fields: [staffId], references: [id], onDelete: Restrict)
  services      AppointmentService[]
  notifications EmailNotification[]

  // Covers overlap queries: WHERE staffId = ? AND status IN (...) AND startsAt < ? AND endsAt > ?
  @@index([staffId, status, startsAt])
  @@index([status, startsAt])
  @@index([customerId, startsAt])
  @@index([startsAt])
}

// Historical snapshot: name/duration/price captured at booking time so later
// service edits never rewrite past appointments.
model AppointmentService {
  id              String  @id @default(cuid())
  appointmentId   String
  serviceId       String?
  serviceNameSv   String  @db.VarChar(160)
  serviceNameEn   String  @db.VarChar(160)
  durationMinutes Int
  price           Decimal @db.Decimal(10, 2)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@index([serviceId])
}

// Scheduling lock rows: one per (staff member, local calendar date). Booking
// transactions upsert/lock this row with SELECT ... FOR UPDATE so concurrent
// bookings for the same staff/day serialize and overlap checks are race-free.
model StaffScheduleLock {
  id        String   @id @default(cuid())
  staffId   String
  lockDate  String   @db.VarChar(10) // YYYY-MM-DD in the business timezone
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  @@unique([staffId, lockDate])
}

// ---------------------------------------------------------------------------
// Business configuration & content
// ---------------------------------------------------------------------------

model BusinessSettings {
  id                     String @id @default("singleton")
  salonName              String @default("Min Salong") @db.VarChar(160)
  descriptionSv          String? @db.Text
  descriptionEn          String? @db.Text
  logoUrl                String? @db.VarChar(500)
  address                String? @db.VarChar(255)
  postalCode             String? @db.VarChar(20)
  city                   String? @db.VarChar(120)
  country                String @default("Sweden") @db.VarChar(120)
  phone                  String? @db.VarChar(40)
  email                  String? @db.VarChar(190)
  mapEmbedUrl            String? @db.VarChar(1000)
  instagramUrl           String? @db.VarChar(500)
  facebookUrl            String? @db.VarChar(500)
  tiktokUrl              String? @db.VarChar(500)
  currency               String @default("SEK") @db.VarChar(10)
  timezone               String @default("Europe/Stockholm") @db.VarChar(60)
  defaultLanguage        String @default("sv") @db.VarChar(10)
  secondaryLanguage      String @default("en") @db.VarChar(10)
  appointmentIntervalMinutes Int @default(15)
  minBookingNoticeMinutes    Int @default(120)
  maxAdvanceBookingDays      Int @default(60)
  pendingReservesTime    Boolean @default(true)
  cancellationPolicySv   String? @db.Text
  cancellationPolicyEn   String? @db.Text
  createdAt              DateTime @default(now()) @db.DateTime(3)
  updatedAt              DateTime @updatedAt @db.DateTime(3)
}

model Testimonial {
  id         String   @id @default(cuid())
  authorName String   @db.VarChar(120)
  textSv     String   @db.Text
  textEn     String?  @db.Text
  rating     Int      @default(5)
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.DateTime(3)
  updatedAt  DateTime @updatedAt @db.DateTime(3)
}

model GalleryImage {
  id        String   @id @default(cuid())
  imageUrl  String   @db.VarChar(500)
  altSv     String?  @db.VarChar(255)
  altEn     String?  @db.VarChar(255)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
}

// ---------------------------------------------------------------------------
// Contact & email
// ---------------------------------------------------------------------------

model ContactMessage {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(160)
  email     String   @db.VarChar(190)
  phone     String?  @db.VarChar(40)
  message   String   @db.Text
  handled   Boolean  @default(false)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  @@index([handled, createdAt])
}

model EmailNotification {
  id            String             @id @default(cuid())
  appointmentId String?
  type          NotificationType
  status        NotificationStatus @default(PENDING)
  toEmail       String             @db.VarChar(190)
  subject       String             @db.VarChar(255)
  htmlBody      String             @db.LongText
  attempts      Int                @default(0)
  lastError     String?            @db.Text
  sentAt        DateTime?          @db.DateTime(3)
  createdAt     DateTime           @default(now()) @db.DateTime(3)
  updatedAt     DateTime           @updatedAt @db.DateTime(3)

  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  // Duplicate guard: only one notification of a given type per appointment.
  @@unique([appointmentId, type])
  @@index([status, createdAt])
}