# Backend environment template — copy to .env and fill in real values.
NODE_ENV=development
PORT=3001

# Local MySQL 8.0+ (no Docker). Create the database first, e.g.:
#   CREATE DATABASE salon_booking CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL="mysql://root:your_password@localhost:3306/salon_booking"

# Separate database used by automated tests (never point this at production data)
TEST_DATABASE_URL="mysql://root:your_password@localhost:3306/salon_booking_test"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace_with_a_secure_random_secret"
JWT_EXPIRES_IN="1d"

# Initial admin account created by the seeder (only if it does not exist).
# Change these before production deployment.
ADMIN_NAME="Salon Administrator"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeThisPassword123!"

FRONTEND_URL="http://localhost:3000"

# SMTP email configuration (optional — bookings succeed even without email).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Salon <no-reply@example.com>"

# Directory for uploaded images, relative to backend/
UPLOAD_DIRECTORY="uploads"

# Set to true only for local demo data seeding (fictional customers/appointments)
SEED_DEMO=false

# Password for the fictional staff login accounts created by the seeder (optional)
STAFF_DEMO_PASSWORD="StaffDemo123!"