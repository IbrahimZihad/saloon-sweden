{
  "name": "salon-backend",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS REST API for the salon booking system",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:cov": "jest --coverage --runInBand",
    "db:sync": "tsx src/database/sync.ts",
    "db:seed": "tsx src/database/seed.ts",
    "db:seed:demo": "cross-env SEED_DEMO=true tsx src/database/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/sequelize": "^12.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.5.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "decimal.js": "^10.6.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "mysql2": "^3.24.6",
    "nodemailer": "^7.0.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.0",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.2.8",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^7.0.3",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^6.0.3",
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
